<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/settingTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Auction Settings"
        android:textSize="28sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/settingBidInput"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginTop="25dp"
        android:hint="Enter bid increment"
        android:inputType="numberDecimal" />

    <EditText
        android:id="@+id/settingTimeInput"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginTop="12dp"
        android:hint="Enter auction duration (minutes)"
        android:inputType="number" />

    <Button
        android:id="@+id/settingSaveButton"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginTop="15dp"
        android:text="Save Settings"
        android:textAllCaps="false" />

    <TextView
        android:id="@+id/settingResult"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="25dp"
        android:textSize="17sp" />

</LinearLayout>
<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/auctionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Player Auction"
            android:textSize="28sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/auctionPlayerName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:text="Player Name"
            android:textSize="22sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/auctionBasePrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Base Price: ₹0"
            android:textSize="18sp"/>

        <TextView
            android:id="@+id/auctionCurrentBid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Current Bid: ₹0"
            android:textSize="20sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/auctionHighestTeam"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Highest Bid Team: None"
            android:textSize="18sp"/>

        <TextView
            android:id="@+id/auctionTimer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="00:00"
            android:textSize="32sp"
            android:textStyle="bold"/>

        <Button
            android:id="@+id/auctionBidButton"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="20dp"
            android:text="Place Bid"
            android:textAllCaps="false"/>

        <Button
            android:id="@+id/auctionSoldButton"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="10dp"
            android:text="SOLD"
            android:textAllCaps="false"/>

        <Button
            android:id="@+id/auctionUnsoldButton"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="10dp"
            android:text="UNSOLD"
            android:textAllCaps="false"/>

        <TextView
            android:id="@+id/auctionTeamList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:textSize="17sp"/>

    </LinearLayout>

</ScrollView>
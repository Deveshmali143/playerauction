<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/cricket">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="PLAYER AUCTION"
        android:textColor="#FFFFFF"
        android:textSize="28sp"
        android:textStyle="bold"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Mobile Auction Management System"
        android:textColor="#FFFFFF"
        android:textSize="15sp"/>

    <Button
        android:id="@+id/btTeams"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginTop="40dp"
        android:text="Manage Teams"
        android:backgroundTint="#FFB300"
        android:textAllCaps="false"/>

    <Button
        android:id="@+id/btPlayers"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginTop="12dp"
        android:text="Manage Players"
        android:backgroundTint="#2E7D32"
        android:textAllCaps="false"/>

    <Button
        android:id="@+id/btSettings"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginTop="12dp"
        android:text="Auction Settings"
        android:backgroundTint="#EF6C00"
        android:textAllCaps="false"/>

    <Button
        android:id="@+id/btAuction"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginTop="12dp"
        android:text="Start Auction"
        android:backgroundTint="#C62828"
        android:textAllCaps="false"/>

</LinearLayout>
